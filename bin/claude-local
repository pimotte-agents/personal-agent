#!/usr/bin/env bash
# Runs Claude Code against the local llama.cpp server (its native Anthropic Messages API,
# http://<host>:8080/v1/messages) instead of the subscription. Same server pi/agent/models.json
# points `pi` at.
set -euo pipefail

unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY

export ANTHROPIC_BASE_URL="http://host.docker.internal:${HOST_ALLOWED_PORT:-8080}"
export ANTHROPIC_AUTH_TOKEN="local"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL}"

exec claude "$@"
